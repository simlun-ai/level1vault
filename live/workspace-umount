#!/bin/sh
set -eu

# Validate the requested export scope and root access.
[ "$#" -le 1 ] || { echo 'Usage: sudo workspace-umount [PAIR_ID|all]' >&2; exit 2; }
PAIR=${1:-all}
case "$PAIR" in
    all) ;;
    ''|0*|*[!0-9]*) echo 'Expected a positive PAIR_ID or all' >&2; exit 2;;
esac
[ "$(id -u)" -eq 0 ] || { echo 'Run: sudo workspace-umount' >&2; exit 1; }

# Reserve exclusive access to workspace operations.
exec 9>/run/lock/level1vault-workspace.lock
flock -x 9

# Select the imported workspace pools to export.
cd /
modprobe zfs
pools=$(zpool list -H -o name)
if [ "$PAIR" = all ]; then
    # Numeric order, with no fixed number of configured pairs. No imports.
    POOLS=$(printf '%s\n' "$pools" | grep -E '^workspace-[1-9][0-9]*$' | sort -t- -k2,2n)
else
    POOLS=workspace-$PAIR
fi

# Validate, sync, and export each selected pool.
for POOL in $POOLS; do
    if ! printf '%s\n' "$pools" | grep -Fxq "$POOL"; then
        continue
    fi
    [ "$(zfs get -H -o value org.level1vault:pair "$POOL")" = "${POOL#workspace-}" ] || {
        echo "Pair identity mismatch for $POOL; refusing export" >&2; exit 1;
    }
    zpool sync "$POOL"
    # Never force a busy pool or power off on failure.
    if ! zpool export "$POOL"; then
        echo 'Export failed. Leave /mnt/workspace in every shell and stop processes using it, then retry before poweroff.' >&2
        exit 1
    fi
done

# Report that the selected pairs can be disconnected.
echo 'Selected workspace pools synced and exported; safe to disconnect those pairs.'
