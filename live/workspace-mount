#!/bin/sh
set -eu
[ "$#" -eq 1 ] || { echo 'Usage: sudo workspace-mount PAIR_ID' >&2; exit 2; }
PAIR=$1
case "$PAIR" in
    ''|0*|*[!0-9]*) echo 'PAIR_ID must be a positive integer without leading zeros' >&2; exit 2;;
esac
POOL=workspace-$PAIR
DATASET=$POOL/data
MOUNTPOINT=/mnt/workspace
[ "$(id -u)" -eq 0 ] || { echo 'Run: sudo /usr/local/sbin/workspace-mount' >&2; exit 1; }
# Serialize manual calls. The lock lives in the RAM overlay.
exec 9>/run/lock/level1vault-workspace.lock
flock -x 9
modprobe zfs
[ -s /etc/hostid ] || zgenhostid
udevadm settle
if ! zpool list -H -o name "$POOL" >/dev/null 2>&1; then
    # Name conflicts and active-host protection intentionally cause failure.
    zpool import -N -d /dev/disk/by-partuuid -o cachefile=none "$POOL"
fi
[ "$(zfs get -H -o value org.level1vault:pair "$POOL")" = "$PAIR" ] || {
    echo 'Pair identity missing or wrong; expected a freshly initialized level1vault pair' >&2; exit 1;
}
if [ "$(zfs get -H -o value encryption "$DATASET")" != aes-256-gcm ] ||
   [ "$(zfs get -H -o value encryptionroot "$DATASET")" != "$DATASET" ] ||
   [ "$(zfs get -H -o value keyformat "$DATASET")" != passphrase ]; then
    echo 'Expected a fresh passphrase-encrypted workspace' >&2; exit 1
fi
STATE=$(zfs get -H -o value org.level1vault:state "$POOL")
READONLY=$(zfs get -H -o value readonly "$DATASET")
case "$STATE:$READONLY" in
    active:off|replica:on) ;;
    *) echo 'Pair state and readonly policy do not agree; inspect before use' >&2; exit 1;;
esac
if [ "$STATE" = active ]; then
    pools=$(zpool list -H -o name)
    for other in $pools; do
        case "$other" in
            workspace-*)
                [ "$other" != "$POOL" ] || continue
                other_state=$(zfs get -H -o value org.level1vault:state "$other")
                case "$other_state" in
                    active|activating) echo "$other is also active/imported; resolve ownership first" >&2; exit 1;;
                esac;;
        esac
    done
fi
# A fixed mountpoint is part of the contract, not a suggestion.
[ "$(zfs get -H -o value mountpoint "$DATASET")" = "$MOUNTPOINT" ] || {
    echo "ERROR: $DATASET must have mountpoint=$MOUNTPOINT" >&2; exit 1;
}
[ "$(zfs get -H -o value canmount "$DATASET")" = noauto ] || {
    echo "ERROR: $DATASET must have canmount=noauto; inspect before changing it" >&2; exit 1;
}
mkdir -p "$MOUNTPOINT"
if mountpoint -q "$MOUNTPOINT"; then
    [ "$(findmnt -n -o SOURCE --mountpoint "$MOUNTPOINT")" = "$DATASET" ] || {
        echo "ERROR: $MOUNTPOINT has a different filesystem mounted" >&2; exit 1;
    }
else
    [ "$(zfs get -H -o value mounted "$DATASET")" = no ] || {
        echo "ERROR: $DATASET is mounted elsewhere" >&2; exit 1;
    }
    [ -z "$(ls -A "$MOUNTPOINT")" ] || {
        echo "ERROR: $MOUNTPOINT is not empty" >&2; exit 1;
    }
    if [ "$(zfs get -H -o value keystatus "$DATASET")" = unavailable ]; then
        zfs load-key -L prompt "$DATASET"
    fi
    zfs mount "$DATASET"
fi
findmnt --mountpoint "$MOUNTPOINT"
zpool status "$POOL"
