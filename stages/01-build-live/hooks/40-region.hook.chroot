#!/bin/sh
set -eu

# Set Stockholm wall time while leaving the hardware clock in UTC.
ln -snf /usr/share/zoneinfo/Europe/Stockholm /etc/localtime
printf 'Europe/Stockholm\n' > /etc/timezone

# Generate US English UTF-8 and leave individual locale categories overridable.
printf 'en_US.UTF-8 UTF-8\n' > /etc/locale.gen
locale-gen
update-locale --reset LANG=en_US.UTF-8 LANGUAGE=en_US:en

# Prepare the US console keymap without requiring a console during the build.
cat > /etc/default/keyboard <<'KEYBOARD'
XKBMODEL="pc105"
XKBLAYOUT="us"
XKBVARIANT=""
XKBOPTIONS=""
BACKSPACE="guess"
KEYBOARD
setupcon --keyboard-only --save-only
systemctl enable keyboard-setup.service console-setup.service

# Keep Debian's boot-time configuration aligned with the installed defaults.
install -d -m 0755 /etc/live/config.conf.d
cat > /etc/live/config.conf.d/region.conf <<'CONFIG'
LIVE_TIMEZONE=Europe/Stockholm
LIVE_LOCALES=en_US.UTF-8
LIVE_KEYBOARD_MODEL=pc105
LIVE_KEYBOARD_LAYOUTS=us
LIVE_KEYBOARD_VARIANTS=""
LIVE_KEYBOARD_OPTIONS=""
LIVE_UTC=yes
CONFIG
