#!/bin/sh
set -eu
# Create the exact account before SquashFS is generated. Boot-time user-setup
# and sudo live-config components are disabled so they cannot replace it.
if getent passwd simlun >/dev/null || getent passwd 1000 >/dev/null || \
   getent group simlun >/dev/null || getent group 1000 >/dev/null; then
    echo 'ERROR: account name or numeric ID 1000 is already allocated' >&2
    exit 1
fi

# Create the live user with the expected identity and password.
groupadd --gid 1000 simlun
useradd --uid 1000 --gid 1000 --create-home --shell /usr/bin/zsh --groups sudo simlun
printf 'simlun:password\n' | chpasswd

# Provide the requested command and manual-page names for Debian's renamed tools.
install -d -m 0755 /usr/local/bin /usr/local/share/man/man1
ln -s /usr/bin/fdfind /usr/local/bin/fd
ln -s /usr/bin/batcat /usr/local/bin/bat
ln -s /usr/share/man/man1/fdfind.1.gz /usr/local/share/man/man1/fd.1.gz
ln -s /usr/share/man/man1/batcat.1.gz /usr/local/share/man/man1/bat.1.gz

# Install the live user's versioned application settings and login command path.
config=/usr/local/lib/level1vault/build/user-config
install -d -o 1000 -g 1000 -m 0755 /home/simlun/.config
install -o 1000 -g 1000 -m 0644 "$config/zshrc" /home/simlun/.zshrc
install -o 1000 -g 1000 -m 0644 "$config/tmux.conf" /home/simlun/.tmux.conf
install -o 1000 -g 1000 -m 0644 "$config/starship.toml" /home/simlun/.config/starship.toml
cat > /home/simlun/.zprofile <<'ZPROFILE'
case ":$PATH:" in
    *:/usr/local/sbin:*) ;;
    *) PATH="/usr/local/sbin:$PATH" ;;
esac
export PATH
ZPROFILE
chown 1000:1000 /home/simlun/.zprofile
chmod 0644 /home/simlun/.zprofile

# Enable passwordless sudo and the administrative command path.
install -d -m 0755 /etc/sudoers.d /etc/profile.d /etc/live/config.conf.d
cat > /etc/sudoers.d/99-level1vault <<'SUDOERS'
Defaults secure_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
simlun ALL=(ALL:ALL) NOPASSWD: ALL
SUDOERS
chmod 0440 /etc/sudoers.d/99-level1vault
visudo -cf /etc/sudoers

# Include workspace commands in the login path.
cat > /etc/profile.d/level1vault-path.sh <<'PROFILE'
case ":$PATH:" in
    *:/usr/local/sbin:*) ;;
    *) PATH="/usr/local/sbin:$PATH" ;;
esac
export PATH
PROFILE

# Preserve the configured account during live boot.
cat > /etc/live/config.conf.d/level1vault.conf <<'CONFIG'
LIVE_USERNAME=root
LIVE_CONFIG_NOCOMPONENTS=user-setup,sudo
CONFIG
[ "$(id -u simlun)" -eq 1000 ]
[ "$(id -g simlun)" -eq 1000 ]

# Enforce root autologin on both local and serial consoles.
# Keep the explicit serial service policy used by workstation QEMU acceptance.
for unit in getty@ serial-getty@; do
    install -d -m 0755 "/etc/systemd/system/$unit.service.d"
    cat > "/etc/systemd/system/$unit.service.d/zz-level1vault-root.conf" <<'GETTY'
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin root --noclear %I $TERM
GETTY
done
sed -i 's/--noclear/--keep-baud --noclear/' /etc/systemd/system/serial-getty@.service.d/zz-level1vault-root.conf

# Show the workspace quick guide at console login.
cat > /etc/motd <<'MOTD'
level1vault workspace quick guide

Run start to unlock your workspace and work as simlun in tmux.
  start                         Select the only complete connected pair.
  start 1                       Select pair 1 explicitly (also for degraded use).
Exit all tmux panes to return to root and choose export, then poweroff.
Detaching leaves tmux running; run start to reattach before exporting.
Root's home and OS changes are temporary. simlun's mounted home persists.

Manual operations (sudo is optional at the root console):
Pair IDs below are examples; use the IDs printed on your USB pairs.
  sudo workspace-mount           Unlock the only complete connected pair.
  sudo workspace-mount 1         Select pair 1 explicitly (also for degraded use).
                                 Active: writable. Replica: read-only.
  sudo workspace-transport-import 1
                                 Verify staged files into encrypted inbox, then remove transport.
  workspace-transport-import-git-bundles /mnt/workspace/inbox/<delivery>/git-bundles
                                 As simlun: update offline checkouts in /mnt/workspace/git/.
  sudo workspace-sync 1 2        Copy active pair 1 to unmounted replica pair 2.
                                 Add more replica IDs to update them too; rerun to resume.
  sudo workspace-prune 1 --keep 10
                                 Preview old checkpoints; add --apply to delete.
                                 Holds, pending checkpoints and user snapshots are kept.
  sudo workspace-activate --next 1 --fenced
                                 Promote the next connected pair after pair 1.
                                 Fence/disconnect the old active pair FIRST.
                                 Then mount the promoted pair using its own ID.
  sudo -iu simlun                Open a login shell after mounting the active pair.
  cd /; sudo workspace-umount    Sync and export all imported workspace pairs.
                                 Exit simlun sessions, tmux and background jobs first.

Export successfully before removing workspace drives; keep the boot USB
connected until shutdown. OS changes reset on reboot; workspace data persists.
More options: workspace-sync --help, workspace-activate --help, workspace-prune --help

Passphrase hint: Ho.
MOTD

