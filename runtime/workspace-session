#!/usr/bin/env python3
"""Own the tmux server and background processes of the live workspace session."""

from __future__ import annotations

import fcntl
import os
import subprocess
import sys
import time
from pathlib import Path

UNIT = "level1vault-session.service"
SOCKET = "/run/level1vault-session/tmux.sock"
LOCK = "/run/lock/level1vault-workspace.lock"
HELPERS = Path(__file__).resolve().parent


def state():
    result = subprocess.run(
        ["systemctl", "show", UNIT, "--property=LoadState,ActiveState"],
        capture_output=True,
        text=True,
        check=True,
    )
    properties = dict(line.split("=", 1) for line in result.stdout.splitlines())
    if properties.get("LoadState") == "not-found":
        return "absent"
    if properties.get("LoadState") != "loaded":
        raise RuntimeError("Cannot inspect the managed workspace service")
    return properties["ActiveState"]


def session_count():
    # Never let an inspection command start an unmanaged tmux server.
    result = subprocess.run(
        ["tmux", "-N", "-S", SOCKET, "display-message", "-p", "#{server_sessions}"],
        capture_output=True,
        text=True,
        check=True,
    )
    value = result.stdout.strip()
    if not value.isascii() or not value.isdecimal():
        raise RuntimeError("Cannot inspect managed tmux sessions; refusing cleanup")
    return int(value)


def prepare():
    # Serialize session creation with mount changes and create panes before unlocking.
    with open(LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        subprocess.run(
            [sys.executable, str(HELPERS / "workspace-home"), "check"], check=True
        )
        current = state()
        if current == "absent":
            # No PAM session is created: the server and its descendants stay in this unit.
            subprocess.run(
                [
                    "systemd-run",
                    "--quiet",
                    "--collect",
                    f"--unit={UNIT}",
                    "--service-type=exec",
                    "--uid=simlun",
                    "--gid=simlun",
                    "--working-directory=/home/simlun",
                    "--property=RuntimeDirectory=level1vault-session",
                    "--property=RuntimeDirectoryMode=0700",
                    "--property=KillMode=control-group",
                    "--property=TimeoutStopSec=5s",
                    "--property=SendSIGKILL=yes",
                    "--setenv=HOME=/home/simlun",
                    "--setenv=USER=simlun",
                    "--setenv=LOGNAME=simlun",
                    "--setenv=SHELL=/usr/bin/zsh",
                    "--setenv=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
                    "--",
                    "/usr/bin/tmux",
                    "-D",
                    "-S",
                    SOCKET,
                ],
                check=True,
            )
            # Type=exec confirms exec, so wait separately for tmux's socket to be ready.
            for attempt in range(50):
                try:
                    session_count()
                    break
                except subprocess.CalledProcessError:
                    if attempt == 49:
                        raise RuntimeError(
                            "Managed tmux did not become ready; inspect journalctl -u "
                            + UNIT
                        ) from None
                    time.sleep(0.1)
        elif current != "active":
            raise RuntimeError(
                f"Workspace service is {current}; inspect journalctl -u {UNIT}"
            )
        client = ["sudo", "-iu", "simlun", "tmux", "-N", "-S", SOCKET]
        existing = subprocess.run(
            [*client, "has-session", "-t", "=workspace"],
            capture_output=True,
            text=True,
        )
        if existing.returncode == 1:
            subprocess.run(
                [*client, "new-session", "-d", "-s", "workspace", "-c", "/home/simlun"],
                check=True,
            )
        elif existing.returncode:
            raise RuntimeError("Cannot inspect the workspace tmux session")


def stop():
    # Called by verified home detach while workspace-umount holds the workspace lock.
    current = state()
    if current == "absent":
        return
    if current == "active":
        if session_count():
            raise RuntimeError(
                "Managed tmux sessions are still running (possibly detached). "
                "Run start to reattach and exit every session before exporting."
            )
    elif current not in ("inactive", "failed"):
        raise RuntimeError(f"Workspace service is {current}; refusing cleanup")

    # systemd sends TERM to the complete cgroup, then KILL after five seconds.
    print("Stopping remaining workspace background processes...", flush=True)
    subprocess.run(["systemctl", "stop", UNIT], check=True)
    if state() not in ("absent", "inactive"):
        raise RuntimeError("Workspace service did not stop; refusing home unmount")


def main():
    if os.geteuid() != 0:
        raise RuntimeError("Run from the root console")
    if not Path("/usr/local/share/level1vault/source-commit").is_file():
        raise RuntimeError("workspace-session is for the level1vault live OS")
    if sys.argv[1:] == ["prepare"]:
        prepare()
    elif sys.argv[1:] == ["stop"]:
        stop()
    else:
        raise RuntimeError("Internal usage: workspace-session prepare | stop")


if __name__ == "__main__":
    try:
        main()
    except (
        RuntimeError,
        OSError,
        ValueError,
        KeyError,
        subprocess.CalledProcessError,
    ) as error:
        print(f"ERROR: {error}", file=sys.stderr)
        sys.exit(1)
