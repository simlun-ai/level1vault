#!/usr/bin/env python3
"""Verify and import staged files into the active encrypted workspace inbox."""

import argparse
import subprocess
import sys
from pathlib import Path

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(
    0,
    str(ROOT / "common")
    if (ROOT / "common").is_dir()
    else "/usr/local/lib/level1vault",
)
from transport import import_transport, workspace_lock  # noqa: E402 - resolve shared helpers after configuring their path


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "pair",
        nargs="?",
        help="Transport source pair; defaults to the mounted active workspace pair",
    )
    args = parser.parse_args()
    with workspace_lock():
        import_transport(args.pair, Path(__file__).with_name("workspace-discover"))


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, ValueError, OSError, subprocess.CalledProcessError) as error:
        sys.exit(
            f"Transport import stopped: {error}. Unverified data is never accepted. Inspect status and rerun to retry import or cleanup."
        )
